#!/bin/sh
# 20g：merge/commit 前语法门（2026-10-07 用户拍板，判例=74dd12e 纯文案带语法错致生产 pbash 装载断）
# 最小零误报：只做 node --check，不堆 lint/typecheck（重门会被绕过=没有门）。
# 覆盖被 commit 的 .ts/.js（.tsx 不在 node --check 能力内，不硬吃）。
set -e
files=$(git diff --cached --name-only --diff-filter=ACM -- '*.ts' '*.js' | grep -v '^$' || true)
[ -z "$files" ] && exit 0
for f in $files; do
	[ -f "$f" ] || continue
	if ! node --check "$f" 2>&1; then
		echo ""
		echo "⛔ pre-commit 语法门：$f 未过 node --check（20g，判例 74dd12e）——修完再 commit。" >&2
		exit 1
	fi
done
exit 0
# hook 门在位
